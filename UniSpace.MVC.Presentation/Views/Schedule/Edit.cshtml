@model UniSpace.Bo.DTOs.ScheduleDTOs.UpdateScheduleDto
@{
    ViewData["Title"] = "Edit Schedule";
}
<link rel="stylesheet" href="~/css/campus-cyber.css" />

<header>Edit Schedule</header>

<div class="page-wrapper form-wrapper">
    <div class="glass-box">
        <h2>Update Schedule</h2>
        <p class="muted">Modify schedule details</p>

        <!-- Conflict Alert container -->
        <div id="conflictAlert" class="alert alert-danger" style="display:none;">
            <i class="fas fa-exclamation-triangle me-2"></i>
            <span id="conflictMessage"></span>
        </div>

        <form asp-action="Edit" method="post" class="cyber-form">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="RoomId" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label">Title / Subject</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="ScheduleType" class="form-label">Type</label>
                    <select asp-for="ScheduleType" class="form-control"
                        asp-items="Html.GetEnumSelectList<UniSpace.Bo.Enums.ScheduleType>()">
                    </select>
                    <span asp-validation-for="ScheduleType" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DayOfWeek" class="form-label">Day of Week</label>
                    <select asp-for="DayOfWeek" class="form-control">
                        <option value="1">Monday</option>
                        <option value="2">Tuesday</option>
                        <option value="3">Wednesday</option>
                        <option value="4">Thursday</option>
                        <option value="5">Friday</option>
                        <option value="6">Saturday</option>
                        <option value="0">Sunday</option>
                    </select>
                    <span asp-validation-for="DayOfWeek" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartTime" class="form-label">Start Time</label>
                    <input asp-for="StartTime" type="time" class="form-control" />
                    <span asp-validation-for="StartTime" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EndTime" class="form-label">End Time</label>
                    <input asp-for="EndTime" type="time" class="form-control" />
                    <span asp-validation-for="EndTime" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StartDate" class="form-label">Effective From</label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="EndDate" class="form-label">Effective To</label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-strong">Save Changes</button>
                <a asp-action="Index" class="btn-soft">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ValidationScriptsPartial" />
    <script src="~/css/campus-cyber.js"></script>
    <script>
        // Real-time conflict checking
        const inputs = '#DayOfWeek, #StartTime, #EndTime, #StartDate, #EndDate';
        $(inputs).on('change', function () {
            checkConflict();
        });

        function checkConflict() {
            var id = $('#Id').val();
            var roomId = $('#RoomId').val();
            var dayOfWeek = $('#DayOfWeek').val();
            var startTime = $('#StartTime').val();
            var endTime = $('#EndTime').val();
            var startDate = $('#StartDate').val();
            var endDate = $('#EndDate').val();

            if (roomId && startTime && endTime && startDate && endDate) {
                $.ajax({
                    url: '@Url.Action("CheckConflict")',
                    type: 'GET',
                    data: {
                        roomId: roomId,
                        dayOfWeek: dayOfWeek,
                        startTime: startTime,
                        endTime: endTime,
                        startDate: startDate,
                        endDate: endDate,
                        excludeId: id
                    },
                    success: function (response) {
                        if (response.hasConflict) {
                            var msg = "Schedule conflict detected!";
                            if (response.conflicts && response.conflicts.length > 0) {
                                var c = response.conflicts[0];
                                msg += ` Overlaps with: ${c.title} (${c.startTime.substring(0, 5)} - ${c.endTime.substring(0, 5)})`;
                            }

                            $('#conflictMessage').text(msg);
                            $('#conflictAlert').slideDown();
                            $('button[type="submit"]').prop('disabled', true);
                        } else {
                            $('#conflictAlert').slideUp();
                            $('button[type="submit"]').prop('disabled', false);
                        }
                    }
                });
            }
        }
    </script>
}
