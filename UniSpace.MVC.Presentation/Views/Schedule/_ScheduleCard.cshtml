@model UniSpace.Bo.DTOs.ScheduleDTOs.ScheduleDto

<div class="card cyber-card mb-3 h-100">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title text-cyber-info text-truncate" title="@Model.Title">@Model.Title</h5>
            <span class="badge bg-cyber-primary">@Model.ScheduleTypeDisplay</span>
        </div>

        <div class="schedule-info mb-3">
            <div class="d-flex align-items-center mb-1 text-muted">
                <i class="fas fa-clock me-2 text-warning"></i>
                <span>@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</span>
            </div>
            <div class="d-flex align-items-center mb-1 text-muted">
                <i class="fas fa-calendar-alt me-2 text-success"></i>
                <small>@Model.DayOfWeekDisplay</small>
            </div>
            <div class="d-flex align-items-center mb-1 text-muted">
                <i class="fas fa-map-marker-alt me-2 text-danger"></i>
                <small>@Model.RoomName</small>
            </div>
            <div class="d-flex align-items-center text-muted">
                <i class="fas fa-university me-2 text-secondary"></i>
                <small>@Model.CampusName</small>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top border-secondary">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-light">
                <i class="fas fa-eye"></i>
            </a>
            @if (User.IsInRole("Admin"))
            {
                <div class="btn-group btn-group-sm">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                        <i class="fas fa-edit"></i>
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="fas fa-trash"></i>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
