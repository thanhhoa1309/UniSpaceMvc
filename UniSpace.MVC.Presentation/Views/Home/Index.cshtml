@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <!-- Hero Section -->
    <div class="row align-items-center mb-5">
        <div class="col-lg-6">
            <h1 class="display-3 fw-bold mb-4">
                Welcome to <span class="text-primary">UniSpace</span>
            </h1>
            <p class="lead mb-4">
                A modern room booking management system for universities.
                Book classrooms, labs, and meeting rooms with ease.
            </p>
            @if (ViewBag.IsAuthenticated)
            {
                <div class="d-grid gap-2 d-md-flex">
                    <a asp-controller="Booking" asp-action="SearchRooms" class="btn btn-primary btn-lg px-4">
                        <i class="fas fa-calendar-plus"></i> Book a Room
                    </a>
                    <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="fas fa-list"></i> My Bookings
                    </a>
                </div>
            }
            else
            {
                <div class="d-grid gap-2 d-md-flex">
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-primary btn-lg px-4">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="fas fa-user-plus"></i> Register
                    </a>
                </div>
            }
        </div>
        <div class="col-lg-6 text-center">
            <i class="fas fa-building fa-10x text-primary opacity-75"></i>
        </div>
    </div>

    <!-- Features Section -->
    <div class="row mb-5">
        <div class="col-12 text-center mb-4">
            <h2 class="display-5 fw-bold">Features</h2>
            <p class="lead text-muted">Everything you need to manage room bookings efficiently</p>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-calendar-check fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">Easy Booking</h5>
                    <p class="card-text">
                        Book rooms quickly with our intuitive interface.
                        Check availability in real-time and reserve your space instantly.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-clock fa-3x text-success mb-3"></i>
                    <h5 class="card-title">Schedule Management</h5>
                    <p class="card-text">
                        View and manage academic schedules.
                        Avoid conflicts with automatic schedule checking.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body text-center">
                    <i class="fas fa-chart-line fa-3x text-warning mb-3"></i>
                    <h5 class="card-title">Reports & Analytics</h5>
                    <p class="card-text">
                        Track room usage, generate reports, and make data-driven decisions
                        about space utilization.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Stats Section -->
    <div class="row mb-5 py-5 bg-light rounded">
        <div class="col-12 text-center mb-4">
            <h2 class="display-5 fw-bold">Why Choose UniSpace?</h2>
        </div>

        <div class="col-md-3 text-center">
            <h3 class="display-4 text-primary fw-bold">
                <i class="fas fa-door-open"></i>
            </h3>
            <p class="lead">Multiple Room Types</p>
            <p class="text-muted">Classrooms, Labs, Stadiums</p>
        </div>

        <div class="col-md-3 text-center">
            <h3 class="display-4 text-success fw-bold">
                <i class="fas fa-clock"></i>
            </h3>
            <p class="lead">24/7 Access</p>
            <p class="text-muted">Book anytime, anywhere</p>
        </div>

        <div class="col-md-3 text-center">
            <h3 class="display-4 text-warning fw-bold">
                <i class="fas fa-bell"></i>
            </h3>
            <p class="lead">Real-time Updates</p>
            <p class="text-muted">Instant booking confirmations</p>
        </div>

        <div class="col-md-3 text-center">
            <h3 class="display-4 text-danger fw-bold">
                <i class="fas fa-shield-alt"></i>
            </h3>
            <p class="lead">Secure & Reliable</p>
            <p class="text-muted">Your data is safe with us</p>
        </div>
    </div>

    <!-- CTA Section -->
    @if (!ViewBag.IsAuthenticated)
    {
        <div class="row mb-5">
            <div class="col-12">
                <div class="card bg-primary text-white">
                    <div class="card-body text-center py-5">
                        <h2 class="card-title display-5 fw-bold mb-4">Ready to Get Started?</h2>
                        <p class="lead mb-4">
                            Join thousands of students and lecturers who trust UniSpace for their room booking needs.
                        </p>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a asp-controller="Auth" asp-action="Register" class="btn btn-light btn-lg px-5">
                                <i class="fas fa-user-plus"></i> Sign Up Now
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .fa-10x {
        font-size: 10em;
    }
</style>