@model UniSpace.Service.Utils.Pagination<UniSpace.Bo.DTOs.CampusDTOs.CampusDto>
@{
    ViewData["Title"] = "Campuses";
}

<style>
    /* Page Container */
    .campus-page-container {
        min-height: 100vh;
        background: #ffffff;
        padding: 40px 0;
    }

    /* Hero Section */
    .campus-hero {
        background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 100%);
        border-radius: 12px;
        padding: 40px;
        margin-bottom: 30px;
        position: relative;
        overflow: hidden;
        border: 1px solid #e5e7eb;
    }

    .decor-circle {
        position: absolute;
        border-radius: 50%;
        opacity: 0.1;
        pointer-events: none;
    }

    .c1 {
        width: 300px;
        height: 300px;
        background: #3b82f6;
        top: -100px;
        right: -100px;
    }

    .c2 {
        width: 200px;
        height: 200px;
        background: #60a5fa;
        bottom: -50px;
        left: -50px;
    }

    .hero-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        z-index: 1;
    }

    .hero-left h1 {
        color: #1f2937;
        font-weight: 700;
        font-size: 2.5rem;
        margin-bottom: 12px;
    }

    .badges {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 16px;
    }

    .badge {
        background: #3b82f6;
        color: #ffffff;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .sub-text {
        color: #6b7280;
        font-size: 1.125rem;
        margin: 0;
    }

    .hero-right {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
    }

    .badge-soft {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        color: #4b5563;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 500;
    }

    .shimmer {
        animation: shimmer 2s infinite;
    }

    @@keyframes shimmer {
        0%, 100% {
            box-shadow: 0 0 10px rgba(59, 130, 246, 0.3);
        }

        50% {
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.6);
        }
    }

    .neon-btn {
        background: #3b82f6;
        color: #ffffff;
        border: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .neon-btn:hover {
            background: #2563eb;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
            color: #ffffff;
        }

    /* Search Bar */
    .search-bar-hero {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        margin-bottom: 24px;
    }

    .search-flex {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .search-flex i {
            color: #3b82f6;
            font-size: 1.25rem;
        }

        .search-flex input {
            flex: 1;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 12px 16px;
            color: #1f2937;
            font-size: 0.9375rem;
            transition: all 0.2s ease;
        }

            .search-flex input:focus {
                outline: none;
                border-color: #3b82f6;
                background: #ffffff;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            }

            .search-flex input::placeholder {
                color: #9ca3af;
            }

    .btn-search {
        background: #3b82f6;
        color: #ffffff;
        border: none;
        padding: 12px 28px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .btn-search:hover {
            background: #2563eb;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }

    /* Tag Strip */
    .tag-strip {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .pill {
        background: #f3f4f6;
        color: #4b5563;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        border: 1px solid #e5e7eb;
    }

        .pill:hover {
            background: #e5e7eb;
            border-color: #3b82f6;
            color: #3b82f6;
        }

        .pill.active {
            background: #3b82f6;
            color: #ffffff;
            border-color: #3b82f6;
        }

    /* Campus Feed */
    .campus-feed {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 24px;
        margin-bottom: 40px;
    }

    /* Pagination */
    .pagination-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 40px;
    }

    .pagination-modern {
        display: flex;
        gap: 8px;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .pg-item a {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        color: #4b5563;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
        font-weight: 500;
        font-size: 0.9375rem;
    }

        .pg-item a:hover {
            background: #f9fafb;
            border-color: #3b82f6;
            color: #3b82f6;
        }

    .pg-item.active a {
        background: #3b82f6;
        color: #ffffff;
        border-color: #3b82f6;
    }

    .pg-item.disabled a {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .hero-flex {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .hero-left h1 {
            font-size: 2rem;
        }

        .campus-feed {
            grid-template-columns: 1fr;
        }

        .search-flex {
            flex-wrap: wrap;
        }

        .btn-search {
            width: 100%;
        }
    }
</style>

<div class="campus-page-container">
    <div class="container-fluid">
        <div class="campus-hero">
            <div class="decor-circle c1"></div>
            <div class="decor-circle c2"></div>

            <div class="hero-flex">
                <div class="hero-left">
                    <div class="badges mb-1">
                        <span class="badge">Campus</span>
                        <span class="small" style="opacity:.95; color: #6b7280;">Manage campuses and classrooms</span>
                    </div>
                    <h1>Campus List</h1>
                    <p class="sub-text">View all campuses and quick actions.</p>
                </div>

                <div class="hero-right">
                    <div class="badge-soft shimmer">Total: @Model.TotalCount</div>
                    <div class="badge-soft">Page: @ViewBag.CurrentPage / @ViewBag.TotalPages</div>
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn neon-btn" asp-action="Create">
                            <i class="fas fa-plus"></i> Add Campus
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- SEARCH BAR -->
        <div class="search-bar-hero">
            <form asp-action="Index" method="get" class="search-flex">
                <i class="fa fa-search"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by name or address..." />
                <button type="submit" class="btn-search">Search</button>
            </form>
        </div>

        <!-- TAGS -->
        <div class="tag-strip mt-3">
            <span class="pill active">All</span>
            <span class="pill">Many Rooms</span>
            <span class="pill">Active</span>
            <span class="pill">New</span>
        </div>

        <!-- CAMPUS LIST -->
        <div class="campus-feed mt-3">
            @foreach (var item in Model)
            {
                @Html.Partial("_CampusCard", item)
            }
        </div>

        <!-- PAGINATION -->
        <nav aria-label="Campus pagination" class="pagination-wrapper mt-4">
            <ul class="pagination-modern">
                <!-- PREVIOUS -->
                <li class="pg-item @(ViewBag.CurrentPage <= 1 ? "disabled" : "")">
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search">
                        <i class="fa fa-chevron-left"></i> Previous
                    </a>
                </li>

                <!-- PAGE NUMBERS -->
                @for (int i = 1; i <= (int)(ViewBag.TotalPages ?? 1); i++)
                {
                    <li class="pg-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a asp-action="Index" asp-route-page="@i" asp-route-search="@ViewBag.Search">@i</a>
                    </li>
                }

                <!-- NEXT -->
                <li class="pg-item @(ViewBag.CurrentPage >= (int)(ViewBag.TotalPages ?? 1) ? "disabled" : "")">
                    <a asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search">
                        Next <i class="fa fa-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</div>