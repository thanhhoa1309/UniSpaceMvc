@model UniSpace.Bo.DTOs.CampusDTOs.CampusDto
@{
    ViewData["Title"] = "Xóa Campus";
}
<link rel="stylesheet" href="~/css/campus-cyber.css" />

<header>Xóa Campus</header>

<div class="page-wrapper">
    <div class="glass-box delete-box">
        <h2 class="danger-text">Bạn có chắc muốn xóa?</h2>
        <p class="muted">Hành động này sẽ ẩn campus khỏi hệ thống.</p>

        <dl class="row mb-3">
            <dt class="col-sm-3">Tên</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Địa chỉ</dt>
            <dd class="col-sm-9">@Model.Address</dd>
        </dl>

        <form asp-action="Delete" method="post" class="form-actions">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn-danger strong w100">Xóa</button>
            <a asp-action="Index" class="btn-soft w100">Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/css/campus-cyber.js"></script>
}
