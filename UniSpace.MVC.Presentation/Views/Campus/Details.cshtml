@model UniSpace.Bo.DTOs.CampusDTOs.CampusDto
@{
    ViewData["Title"] = "Campus Details";
}

<link rel="stylesheet" href="~/css/campus-cyber.css" />

<div class="campus-hero small-hero">
    <h1 class="hero-title">Campus Details</h1>
    <p class="hero-sub">View detailed information about the campus</p>
</div>

<div class="details-wrapper">
    <div class="campus-details-card">

        <h2 class="details-title">@Model.Name</h2>
        <p class="details-sub">@Model.Address</p>

        <div class="details-grid">
            <div class="details-row">
                <label class="details-label">Name:</label>
                <div class="details-value">@Model.Name</div>
            </div>

            <div class="details-row">
                <label class="details-label">Address:</label>
                <div class="details-value">@Model.Address</div>
            </div>

            <div class="details-row">
                <label class="details-label">Total Rooms:</label>
                <div class="details-value">@Model.TotalRooms</div>
            </div>

            <div class="details-row">
                <label class="details-label">Created Date:</label>
                <div class="details-value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        </div>

        <div class="details-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-primary">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-danger">Delete</a>
            <a asp-action="Index" class="btn-soft">Back</a>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/campus-cyber.js"></script>
}
