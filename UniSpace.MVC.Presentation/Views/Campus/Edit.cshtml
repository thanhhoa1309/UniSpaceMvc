@model UniSpace.Bo.DTOs.CampusDTOs.UpdateCampusDto
@{
    ViewData["Title"] = "Edit Campus";
}
<link rel="stylesheet" href="~/css/campus-cyber.css" />

<header>Edit Campus</header>

<div class="page-wrapper form-wrapper">
    <div class="glass-box">
        <h2>Update Information</h2>
        <p class="muted">Adjust campus details here</p>

        <form asp-action="Edit" method="post" class="cyber-form">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Campus Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter campus name..." />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">Address</label>
                <input asp-for="Address" class="form-control" placeholder="Enter address..." />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-strong">Update</button>
                <a asp-action="Index" class="btn-soft">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/css/campus-cyber.js"></script>
}
