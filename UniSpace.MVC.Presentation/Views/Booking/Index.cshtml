@model IEnumerable<UniSpace.Bo.DTOs.BookingDTOs.BookingDto>
@using UniSpace.Bo.Enums
@{
    ViewData["Title"] = "All Bookings";
}

<style>
    /* Page Container */
    .bookings-container {
        min-height: 100vh;
        background: #ffffff;
        padding: 40px 0;
    }

    /* Main Card */
    .bookings-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        margin-bottom: 30px;
    }

    /* Card Header */
    .bookings-card-header {
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        padding: 24px 28px;
    }

        .bookings-card-header h4 {
            color: #1f2937;
            font-weight: 600;
            margin: 0;
            font-size: 1.5rem;
        }

    /* Card Body */
    .bookings-card-body {
        padding: 28px;
    }

    /* Filter Section */
    .filter-section {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 24px;
    }

        .filter-section h6 {
            color: #3b82f6;
            font-weight: 600;
            margin-bottom: 16px;
            font-size: 1rem;
        }

    .form-control-modern,
    .form-select-modern {
        background: #ffffff;
        border: 1px solid #d1d5db;
        color: #1f2937;
        border-radius: 6px;
        padding: 10px 15px;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .form-control-modern:focus,
        .form-select-modern:focus {
            background: #ffffff;
            border-color: #3b82f6;
            color: #1f2937;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            outline: none;
        }

        .form-control-modern::placeholder {
            color: #9ca3af;
        }

    .form-label-modern {
        color: #374151;
        font-weight: 500;
        margin-bottom: 8px;
        font-size: 0.875rem;
    }

    /* Table Styles */
    .table-modern {
        color: #4b5563;
        margin-bottom: 0;
    }

        .table-modern thead {
            background: #f9fafb;
            border-bottom: 2px solid #e5e7eb;
        }

            .table-modern thead th {
                color: #3b82f6;
                font-weight: 600;
                border: none;
                padding: 16px 12px;
                font-size: 0.875rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

        .table-modern tbody tr {
            border-bottom: 1px solid #f3f4f6;
            transition: all 0.2s ease;
        }

            .table-modern tbody tr:hover {
                background: #f9fafb;
            }

        .table-modern tbody td {
            padding: 16px 12px;
            vertical-align: middle;
            border: none;
            font-size: 0.9375rem;
        }

        .table-modern strong {
            color: #1f2937;
            font-weight: 600;
        }

        .table-modern .text-muted {
            color: #6b7280 !important;
            font-size: 0.875rem;
        }

    /* Status Badges */
    .badge-status-modern {
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.8125rem;
        border: 1px solid;
    }

    .badge-pending-modern {
        background: #fef3c7;
        border-color: #fbbf24;
        color: #92400e;
    }

    .badge-approved-modern {
        background: #dcfce7;
        border-color: #22c55e;
        color: #15803d;
    }

    .badge-rejected-modern {
        background: #fee2e2;
        border-color: #f87171;
        color: #991b1b;
    }

    .badge-completed-modern {
        background: #dbeafe;
        border-color: #60a5fa;
        color: #1e40af;
    }

    .badge-cancelled-modern {
        background: #f3f4f6;
        border-color: #9ca3af;
        color: #4b5563;
    }

    /* Action Buttons */
    .btn-filter-modern {
        background: #3b82f6;
        border: none;
        color: #ffffff;
        font-weight: 500;
        padding: 10px 24px;
        border-radius: 6px;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .btn-filter-modern:hover {
            background: #2563eb;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
            color: #ffffff;
        }

    .btn-clear-modern {
        background: #ffffff;
        border: 1px solid #d1d5db;
        color: #6b7280;
        font-weight: 500;
        padding: 10px 24px;
        border-radius: 6px;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .btn-clear-modern:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #374151;
        }

    .btn-view-modern {
        background: #3b82f6;
        border: none;
        color: #ffffff;
        font-weight: 500;
        padding: 6px 16px;
        border-radius: 6px;
        font-size: 0.875rem;
        transition: all 0.2s ease;
    }

        .btn-view-modern:hover {
            background: #2563eb;
            box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
            color: #ffffff;
        }

    .btn-back-modern {
        background: #ffffff;
        border: 1px solid #d1d5db;
        color: #6b7280;
        font-weight: 500;
        padding: 8px 20px;
        border-radius: 6px;
        transition: all 0.2s ease;
        text-decoration: none;
        font-size: 0.9375rem;
    }

        .btn-back-modern:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #374151;
        }

    /* Pagination */
    .pagination-modern {
        margin-top: 24px;
        display: flex;
        justify-content: center;
        gap: 8px;
    }

        .pagination-modern .page-link {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            color: #4b5563;
            padding: 8px 16px;
            border-radius: 6px;
            transition: all 0.2s ease;
            font-size: 0.9375rem;
        }

            .pagination-modern .page-link:hover {
                background: #f9fafb;
                border-color: #3b82f6;
                color: #3b82f6;
            }

        .pagination-modern .page-item.active .page-link {
            background: #3b82f6;
            border-color: #3b82f6;
            color: #ffffff;
        }

        .pagination-modern .page-item.disabled .page-link {
            opacity: 0.5;
            cursor: not-allowed;
            background: #f9fafb;
        }

    /* Empty State */
    .empty-state-modern {
        text-align: center;
        padding: 60px 20px;
        color: #6b7280;
    }

        .empty-state-modern i {
            font-size: 4rem;
            color: #3b82f6;
            margin-bottom: 20px;
            opacity: 0.3;
        }

        .empty-state-modern h5 {
            color: #374151;
            font-weight: 600;
            margin-bottom: 12px;
        }

    /* Alert */
    .alert-modern-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 20px;
        color: #dc2626;
    }

    /* Icon Styling */
    .icon-primary {
        color: #3b82f6;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .table-modern {
            font-size: 0.875rem;
        }

            .table-modern thead th,
            .table-modern tbody td {
                padding: 12px 8px;
            }

        .bookings-card-body {
            padding: 20px;
        }
    }
</style>

<div class="bookings-container">
    <div class="container-fluid">
        <div class="bookings-card">
            <div class="bookings-card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <h4><i class="fas fa-calendar-check icon-primary"></i> All Bookings Management</h4>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-back-modern btn-sm">
                            <i class="fas fa-arrow-left"></i> Back to Dashboard
                        </a>
                    }
                </div>
            </div>

            <div class="bookings-card-body">
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert-modern-error alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle"></i> <strong>Error!</strong> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <!-- Filter Section -->
                <div class="filter-section">
                    <h6><i class="fas fa-filter"></i> Filter Bookings</h6>
                    <form asp-controller="Booking" asp-action="Index" method="get">
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="form-label-modern">Search</label>
                                <input type="text" name="search" class="form-control form-control-modern"
                                       placeholder="Room, user, email..." value="@ViewBag.Search" />
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label-modern">Status</label>
                                <select name="status" class="form-select form-select-modern">
                                    <option value="">All Status</option>
                                    <option value="0" selected="@(ViewBag.Status == BookingStatus.Pending)">Pending</option>
                                    <option value="1" selected="@(ViewBag.Status == BookingStatus.Approved)">Approved</option>
                                    <option value="2" selected="@(ViewBag.Status == BookingStatus.Rejected)">Rejected</option>
                                    <option value="3" selected="@(ViewBag.Status == BookingStatus.Completed)">Completed</option>
                                    <option value="4" selected="@(ViewBag.Status == BookingStatus.Cancelled)">Cancelled</option>
                                </select>
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label-modern">From Date</label>
                                <input type="date" name="fromDate" class="form-control form-control-modern"
                                       value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-2 mb-3">
                                <label class="form-label-modern">To Date</label>
                                <input type="date" name="toDate" class="form-control form-control-modern"
                                       value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
                            </div>
                            <div class="col-md-3 mb-3 d-flex align-items-end gap-2">
                                <button type="submit" class="btn btn-filter-modern flex-fill">
                                    <i class="fas fa-search"></i> Filter
                                </button>
                                <a asp-controller="Booking" asp-action="Index" class="btn btn-clear-modern flex-fill">
                                    <i class="fas fa-times"></i> Clear
                                </a>
                            </div>
                        </div>
                    </form>
                </div>

                @if (Model != null && Model.Any())
                {
                    <!-- Table -->
                    <div class="table-responsive">
                        <table class="table table-modern">
                            <thead>
                                <tr>
                                    <th>Room</th>
                                    <th>User</th>
                                    <th>Start Time</th>
                                    <th>End Time</th>
                                    <th>Duration</th>
                                    <th>Status</th>
                                    <th>Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in Model)
                                {
                                    <tr>
                                        <td>
                                            <strong>@booking.RoomName</strong><br>
                                            <small class="text-muted">@booking.CampusName</small>
                                        </td>
                                        <td>
                                            <strong>@booking.UserName</strong><br>
                                            <small class="text-muted">@booking.UserEmail</small>
                                        </td>
                                        <td>
                                            @booking.StartTime.ToString("MMM dd, yyyy")<br>
                                            <strong style="color: #3b82f6;">@booking.StartTime.ToString("HH:mm")</strong>
                                        </td>
                                        <td>
                                            @booking.EndTime.ToString("MMM dd, yyyy")<br>
                                            <strong style="color: #3b82f6;">@booking.EndTime.ToString("HH:mm")</strong>
                                        </td>
                                        <td>
                                            @{
                                                var duration = booking.EndTime - booking.StartTime;
                                                <strong style="color: #3b82f6;">@($"{duration.TotalHours:F1}h")</strong>
                                            }
                                        </td>
                                        <td>
                                            @{
                                                var badgeClass = booking.Status switch
                                                {
                                                    BookingStatus.Pending => "badge-pending-modern",
                                                    BookingStatus.Approved => "badge-approved-modern",
                                                    BookingStatus.Rejected => "badge-rejected-modern",
                                                    BookingStatus.Completed => "badge-completed-modern",
                                                    BookingStatus.Cancelled => "badge-cancelled-modern",
                                                    _ => "badge-cancelled-modern"
                                                };
                                            }
                                            <span class="badge-status-modern @badgeClass">
                                                @booking.StatusDisplay
                                            </span>
                                        </td>
                                        <td>
                                            @booking.CreatedAt.ToString("MMM dd, yyyy")<br>
                                            <small class="text-muted">@booking.CreatedAt.ToString("HH:mm")</small>
                                        </td>
                                        <td>
                                            <a asp-controller="Booking" asp-action="Details" asp-route-id="@booking.Id"
                                               asp-route-fromAdmin="true" class="btn btn-view-modern">
                                                <i class="fas fa-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    @if (ViewBag.TotalPages > 1)
                    {
                        <nav class="pagination-modern">
                            <ul class="pagination">
                                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" asp-controller="Booking" asp-action="Index"
                                       asp-route-page="@(ViewBag.CurrentPage - 1)" asp-route-search="@ViewBag.Search"
                                       asp-route-status="@ViewBag.Status" asp-route-fromDate="@ViewBag.FromDate"
                                       asp-route-toDate="@ViewBag.ToDate">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                </li>

                                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                {
                                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                        <a class="page-link" asp-controller="Booking" asp-action="Index" asp-route-page="@i"
                                           asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status"
                                           asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                    <a class="page-link" asp-controller="Booking" asp-action="Index"
                                       asp-route-page="@(ViewBag.CurrentPage + 1)" asp-route-search="@ViewBag.Search"
                                       asp-route-status="@ViewBag.Status" asp-route-fromDate="@ViewBag.FromDate"
                                       asp-route-toDate="@ViewBag.ToDate">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="empty-state-modern">
                        <i class="fas fa-calendar-times"></i>
                        <h5>No Bookings Found</h5>
                        <p>There are no bookings matching your criteria.</p>
                        @if (ViewBag.Search != null || ViewBag.Status != null || ViewBag.FromDate != null || ViewBag.ToDate != null)
                        {
                            <a asp-controller="Booking" asp-action="Index" class="btn btn-filter-modern mt-3">
                                <i class="fas fa-times"></i> Clear Filters
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>