@model IEnumerable<UniSpace.Bo.DTOs.BookingDTOs.BookingDto>
@using UniSpace.Bo.Enums
@{
    ViewData["Title"] = "My Bookings";
}

<style>
    /* Page Container */
    .mybookings-page-container {
        min-height: 100vh;
        background: #ffffff;
        padding: 40px 0;
    }

    /* Main Card */
    .mybookings-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        margin-bottom: 30px;
    }

    /* Card Header */
    .mybookings-card-header {
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        padding: 24px 28px;
    }

        .mybookings-card-header h4 {
            color: #1f2937;
            font-weight: 600;
            margin: 0;
            font-size: 1.5rem;
        }

    /* Card Body */
    .mybookings-card-body {
        padding: 28px;
    }

    /* Real-time indicator */
    .badge-live {
        background: #dbeafe;
        border: 1px solid #60a5fa;
        color: #1e40af;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.8125rem;
        animation: pulse 2s infinite;
    }

    /* Buttons */
    .btn-primary-modern {
        background: #3b82f6;
        border: none;
        color: #ffffff;
        font-weight: 500;
        padding: 8px 20px;
        border-radius: 6px;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .btn-primary-modern:hover {
            background: #2563eb;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
            color: #ffffff;
        }

    /* Alert Styling */
    .alert-modern-danger {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 16px 20px;
        color: #dc2626;
        margin-bottom: 20px;
    }

    .alert-modern-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        padding: 16px 20px;
        color: #16a34a;
        margin-bottom: 20px;
    }

    .alert-modern-info {
        background: #f0f9ff;
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        padding: 16px 20px;
        color: #1e40af;
    }

    /* Filter Section */
    .filter-section {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 24px;
    }

    .form-label-modern {
        color: #374151;
        font-weight: 500;
        font-size: 0.875rem;
        margin-bottom: 8px;
    }

    .form-select-modern {
        background: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        color: #1f2937;
        padding: 10px 14px;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .form-select-modern:focus {
            background: #ffffff;
            border-color: #3b82f6;
            outline: none;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            color: #1f2937;
        }

    /* Table Styling */
    .table-modern {
        color: #4b5563;
        margin-bottom: 0;
    }

        .table-modern thead th {
            background: #f9fafb;
            color: #3b82f6;
            font-weight: 600;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #e5e7eb;
            padding: 16px 12px;
            border: none;
        }

        .table-modern tbody tr {
            border-bottom: 1px solid #f3f4f6;
            transition: all 0.2s ease;
        }

            .table-modern tbody tr:hover {
                background: #f9fafb;
            }

        .table-modern tbody td {
            padding: 16px 12px;
            vertical-align: middle;
            border: none;
            font-size: 0.9375rem;
        }

        .table-modern strong {
            color: #1f2937;
            font-weight: 600;
        }

        .table-modern .text-muted {
            color: #6b7280 !important;
            font-size: 0.875rem;
        }

    /* Status Badges */
    .badge-modern-pending {
        background: #fef3c7;
        border: 1px solid #fbbf24;
        color: #92400e;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.8125rem;
    }

    .badge-modern-success {
        background: #dcfce7;
        border: 1px solid #22c55e;
        color: #15803d;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.8125rem;
    }

    .badge-modern-danger {
        background: #fee2e2;
        border: 1px solid #f87171;
        color: #991b1b;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.8125rem;
    }

    .badge-modern-info {
        background: #dbeafe;
        border: 1px solid #60a5fa;
        color: #1e40af;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.8125rem;
    }

    .badge-modern-secondary {
        background: #f3f4f6;
        border: 1px solid #9ca3af;
        color: #4b5563;
        padding: 6px 12px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.8125rem;
    }

    /* Action Buttons */
    .btn-action-modern {
        padding: 6px 12px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 0.875rem;
        margin: 0 2px;
    }

    .btn-action-info {
        background: #dbeafe;
        color: #1e40af;
        border: 1px solid #bfdbfe;
    }

        .btn-action-info:hover {
            background: #bfdbfe;
            box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
            color: #1e3a8a;
        }

    .btn-action-warning {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
    }

        .btn-action-warning:hover {
            background: #fde68a;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
            color: #78350f;
        }

    .btn-action-danger {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

        .btn-action-danger:hover {
            background: #fecaca;
            box-shadow: 0 2px 8px rgba(239, 68, 68, 0.3);
            color: #7f1d1d;
        }

    .btn-action-dark {
        background: #f3f4f6;
        color: #4b5563;
        border: 1px solid #e5e7eb;
    }

        .btn-action-dark:hover {
            background: #e5e7eb;
            box-shadow: 0 2px 8px rgba(75, 85, 99, 0.3);
            color: #374151;
        }

    /* Animation */
    @@keyframes glow {
        0%,
        100% {
            background-color: transparent;
        }

        50% {
            background-color: rgba(16, 185, 129, 0.1);
        }
    }

    .table-success {
        animation: glow 2s ease-in-out;
    }

    .table-info {
        animation: glow 3s ease-in-out;
        background-color: rgba(59, 130, 246, 0.1) !important;
    }

    @@keyframes pulse {
        0%,
        100% {
            opacity: 1;
        }

        50% {
            opacity: 0.7;
        }
    }

    /* Empty State */
    .empty-state-modern {
        text-align: center;
        padding: 60px 40px;
        color: #6b7280;
    }

        .empty-state-modern i {
            font-size: 4rem;
            color: #3b82f6;
            margin-bottom: 20px;
            opacity: 0.3;
        }

        .empty-state-modern h5 {
            color: #374151;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .empty-state-modern a {
            color: #3b82f6;
            text-decoration: none;
            font-weight: 600;
        }

            .empty-state-modern a:hover {
                color: #2563eb;
                text-decoration: underline;
            }

    /* Icon Styling */
    .icon-primary {
        color: #3b82f6;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .mybookings-card-body {
            padding: 20px;
        }
    }
</style>

<div class="mybookings-page-container">
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="mybookings-card">
                    <div class="mybookings-card-header">
                        <div class="d-flex align-items-center justify-content-between">
                            <h4 class="mb-0">
                                <i class="bi bi-calendar-check icon-primary"></i> My Bookings
                                <span class="badge-live ms-2" id="realTimeIndicator" style="display:none;">
                                    <i class="bi bi-broadcast"></i> Live
                                </span>
                            </h4>
                        </div>
                    </div>
                    <div class="mybookings-card-body">
                        @if (TempData["Error"] != null)
                        {
                            <div class="alert-modern-danger alert-dismissible fade show" role="alert">
                                <i class="bi bi-exclamation-circle"></i> <strong>Error!</strong> @TempData["Error"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert-modern-success alert-dismissible fade show" role="alert">
                                <i class="bi bi-check-circle"></i> <strong>Success!</strong> @TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        <!-- Real-time notification area -->
                        <div id="realtimeNotification" class="alert-modern-success alert-dismissible fade show d-none"
                             role="alert">
                            <i class="bi bi-info-circle"></i> <span id="notificationMessage"></span>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>

                        <!-- Filter -->
                        <div class="filter-section">
                            <form asp-action="MyBookings" asp-controller="Booking" method="get" class="row g-3">
                                <div class="col-md-3">
                                    <label for="statusFilter" class="form-label-modern">
                                        <i class="bi bi-funnel icon-primary"></i> Filter by Status
                                    </label>
                                    <select class="form-select form-select-modern" id="statusFilter" name="status"
                                            onchange="this.form.submit()">
                                        <option value="">All Statuses</option>
                                        <option value="0">Pending</option>
                                        <option value="1">Approved</option>
                                        <option value="2">Rejected</option>
                                        <option value="3">Completed</option>
                                        <option value="4">Cancelled</option>
                                    </select>
                                </div>
                            </form>
                        </div>

                        @if (Model != null && Model.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-modern align-middle mb-0" id="bookingsTable">
                                    <thead>
                                        <tr>
                                            <th>ROOM</th>
                                            <th>TIME</th>
                                            <th>PURPOSE</th>
                                            <th class="text-center">STATUS</th>
                                            <th class="text-center">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var booking in Model)
                                        {
                                            <tr data-booking-id="@booking.Id" id="booking-@booking.Id">
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <strong class="mb-1">@booking.RoomName</strong>
                                                        <small class="text-muted">
                                                            @booking.CampusName | @booking.RoomTypeDisplay
                                                        </small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <div class="d-flex flex-column">
                                                        <strong class="mb-1">
                                                            @booking.StartTime.ToLocalTime().ToString("MMM dd, yyyy")
                                                        </strong>
                                                        <small class="text-muted">
                                                            @booking.StartTime.ToLocalTime().ToString("HH:mm") -
                                                            @booking.EndTime.ToLocalTime().ToString("HH:mm")
                                                        </small>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="text-muted">
                                                        @(booking.Purpose.Length > 50 ? booking.Purpose.Substring(0, 50) + "..." : booking.Purpose)
                                                    </span>
                                                </td>
                                                <td class="text-center booking-status">
                                                    @{
                                                        var badgeClass = booking.Status switch
                                                        {
                                                            BookingStatus.Pending => "badge-modern-pending",
                                                            BookingStatus.Approved => "badge-modern-success",
                                                            BookingStatus.Rejected => "badge-modern-danger",
                                                            BookingStatus.Completed => "badge-modern-info",
                                                            BookingStatus.Cancelled => "badge-modern-secondary",
                                                            _ => "badge-modern-secondary"
                                                        };
                                                    }
                                                    <span class="badge @badgeClass status-badge" data-status="@booking.Status">
                                                        @booking.StatusDisplay
                                                    </span>
                                                    @if (!string.IsNullOrEmpty(booking.AdminNote))
                                                    {
                                                        <br>
                                                        <small class="text-muted mt-1 admin-note">Note: @booking.AdminNote</small>
                                                    }
                                                </td>
                                                <td>
                                                    <div class="action-buttons d-flex justify-content-center">
                                                        <a asp-controller="Booking" asp-action="Details"
                                                           asp-route-id="@booking.Id"
                                                           class="btn btn-action-modern btn-action-info" title="View Details">
                                                            <i class="bi bi-eye"></i>
                                                        </a>

                                                        @if (booking.Status == BookingStatus.Pending)
                                                        {
                                                            <a asp-controller="Booking" asp-action="Edit" asp-route-id="@booking.Id"
                                                               class="btn btn-action-modern btn-action-warning action-edit"
                                                               title="Edit">
                                                                <i class="bi bi-pencil"></i>
                                                            </a>
                                                        }

                                                        @if (booking.Status == BookingStatus.Pending || booking.Status == BookingStatus.Approved)
                                                        {
                                                            <form asp-controller="Booking" asp-action="Cancel" method="post"
                                                                  class="d-inline action-cancel"
                                                                  onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@booking.Id" />
                                                                <button type="submit" class="btn btn-action-modern btn-action-danger"
                                                                        title="Cancel">
                                                                    <i class="bi bi-x-circle"></i>
                                                                </button>
                                                            </form>
                                                        }

                                                        @if (booking.Status == BookingStatus.Completed)
                                                        {
                                                            <a asp-controller="RoomReport" asp-action="Create"
                                                               asp-route-bookingId="@booking.Id"
                                                               class="btn btn-action-modern btn-action-dark action-report"
                                                               title="Report Issue">
                                                                <i class="bi bi-exclamation-triangle"></i>
                                                            </a>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state-modern">
                                <i class="bi bi-calendar-x"></i>
                                <h5 class="mt-3">You don't have any bookings yet.</h5>
                                <p class="mt-2">
                                    <a asp-controller="Booking" asp-action="SearchRooms">Start booking now!</a>
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script>
        $(document).ready(function () {
            // Initialize SignalR connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/bookingHub")
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Information)
                .build();

            // Connection handlers
            connection.onreconnecting(() => {
                console.log('SignalR: Reconnecting...');
                $('#realTimeIndicator').removeClass('badge-live').addClass('badge-modern-secondary').show();
            });

            connection.onreconnected(() => {
                console.log('SignalR: Reconnected');
                $('#realTimeIndicator').removeClass('badge-modern-secondary').addClass('badge-live');
                showNotification('Connection restored', 'success');
            });

            connection.onclose(() => {
                console.log('SignalR: Connection closed');
                $('#realTimeIndicator').hide();
            });

            // Listen for booking status updates
            connection.on("BookingStatusUpdated", function (data) {
                console.log('Booking status updated:', data);
                updateBookingStatus(data.bookingId, data.status, data.message);
                showNotification(data.message, 'info');
            });

            // Listen for booking completion
            connection.on("BookingCompleted", function (data) {
                console.log('Booking completed:', data);
                updateBookingToCompleted(data.bookingId, data.roomName);
                showNotification(`Your booking for "${data.roomName}" has been completed!`, 'success');
            });

            // Start connection
            connection.start()
                .then(() => {
                    console.log('SignalR: Connected');
                    $('#realTimeIndicator').show();
                })
                .catch(err => {
                    console.error('SignalR connection error:', err);
                });

            // Update booking status in UI
            function updateBookingStatus(bookingId, newStatus, message) {
                const row = $(`tr[data-booking-id="${bookingId}"]`);
                if (row.length === 0) return;

                const statusCell = row.find('.booking-status');
                const statusBadge = statusCell.find('.status-badge');

                // Update badge class and text
                const statusInfo = getStatusInfo(newStatus);
                statusBadge.removeClass()
                    .addClass(`badge ${statusInfo.class} status-badge`)
                    .attr('data-status', newStatus)
                    .text(statusInfo.text);

                // Add glow animation
                row.addClass('table-success');
                setTimeout(() => row.removeClass('table-success'), 2000);

                // Update actions based on new status
                updateActionButtons(row, newStatus);
            }

            function updateBookingToCompleted(bookingId, roomName) {
                const row = $(`tr[data-booking-id="${bookingId}"]`);
                if (row.length === 0) return;

                // Update status badge
                const statusBadge = row.find('.status-badge');
                statusBadge.removeClass()
                    .addClass('badge badge-modern-info status-badge')
                    .attr('data-status', 'Completed')
                    .text('Completed');

                // Add report button
                const actionsCell = row.find('.action-buttons');
                actionsCell.find('.action-edit, .action-cancel').remove();

                if (actionsCell.find('.action-report').length === 0) {
                    actionsCell.append(`
                        <a href="/RoomReport/Create?bookingId=${bookingId}"
                           class="btn btn-action-modern btn-action-dark action-report"
                           title="Report Issue">
                            <i class="bi bi-exclamation-triangle"></i>
                        </a>
                    `);
                }

                // Highlight row
                row.addClass('table-info');
                setTimeout(() => row.removeClass('table-info'), 3000);
            }

            function updateActionButtons(row, status) {
                const actionsCell = row.find('.action-buttons');

                // Remove old action buttons
                actionsCell.find('.action-edit, .action-cancel, .action-report').remove();

                // Add appropriate buttons based on status
                if (status === 'Pending') {
                    // Add edit button
                    actionsCell.append(`
                        <a href="/Booking/Edit?id=${row.data('booking-id')}"
                           class="btn btn-action-modern btn-action-warning action-edit"
                           title="Edit">
                            <i class="bi bi-pencil"></i>
                        </a>
                    `);
                }

                if (status === 'Pending' || status === 'Approved') {
                    // Add cancel button
                    actionsCell.append(`
                        <form method="post"
                              action="/Booking/Cancel?id=${row.data('booking-id')}"
                              class="d-inline action-cancel"
                              onsubmit="return confirm('Are you sure?');">
                            <button type="submit"
                                    class="btn btn-action-modern btn-action-danger"
                                    title="Cancel">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        </form>
                    `);
                }

                if (status === 'Completed') {
                    // Add report button
                    actionsCell.append(`
                        <a href="/RoomReport/Create?bookingId=${row.data('booking-id')}"
                           class="btn btn-action-modern btn-action-dark action-report"
                           title="Report Issue">
                            <i class="bi bi-exclamation-triangle"></i>
                        </a>
                    `);
                }
            }

            function getStatusInfo(status) {
                const statusMap = {
                    'Pending': { class: 'badge-modern-pending', text: 'Pending' },
                    'Approved': { class: 'badge-modern-success', text: 'Approved' },
                    'Rejected': { class: 'badge-modern-danger', text: 'Rejected' },
                    'Completed': { class: 'badge-modern-info', text: 'Completed' },
                    'Cancelled': { class: 'badge-modern-secondary', text: 'Cancelled' }
                };
                return statusMap[status] || { class: 'badge-modern-secondary', text: status };
            }

            function showNotification(message, type = 'info') {
                const notification = $('#realtimeNotification');
                const messageSpan = $('#notificationMessage');

                // Update notification style
                notification.removeClass('alert-modern-info alert-modern-success alert-modern-danger')
                    .addClass(`alert-modern-${type}`);

                // Set message
                messageSpan.text(message);

                // Show notification
                notification.removeClass('d-none').addClass('show');

                // Auto hide after 5 seconds
                setTimeout(() => {
                    notification.removeClass('show').addClass('d-none');
                }, 5000);
            }
        });
    </script>
}