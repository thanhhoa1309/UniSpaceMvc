@model UniSpace.Bo.DTOs.BookingDTOs.UpdateBookingDto
@{
    ViewData["Title"] = "Edit Booking";
}

<style>
    /* Page Container */
    .edit-booking-page-container {
        min-height: 100vh;
        background: #ffffff;
        padding: 40px 0;
    }

    /* Main Card */
    .edit-card {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        margin-bottom: 30px;
    }

    /* Card Header */
    .edit-card-header {
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        padding: 24px 28px;
    }

        .edit-card-header h4 {
            color: #1f2937;
            font-weight: 600;
            margin: 0;
            font-size: 1.5rem;
        }

    /* Card Body */
    .edit-card-body {
        padding: 28px;
    }

    /* Room Info Alert */
    .room-info-box {
        background: #f0f9ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 20px;
        margin-bottom: 24px;
    }

        .room-info-box h5 {
            color: #1e40af;
            font-weight: 600;
            margin-bottom: 12px;
            font-size: 1.125rem;
        }

        .room-info-box p {
            color: #4b5563;
            margin: 0;
            line-height: 1.8;
            font-size: 0.9375rem;
        }

        .room-info-box strong {
            color: #374151;
        }

    /* Form Labels */
    .form-label-modern {
        color: #374151;
        font-weight: 500;
        font-size: 0.875rem;
        margin-bottom: 8px;
        display: block;
    }

        .form-label-modern i {
            color: #3b82f6;
            margin-right: 6px;
        }

        .form-label-modern .text-danger {
            color: #dc2626;
        }

    /* Form Controls */
    .form-control-modern {
        background: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        color: #1f2937;
        padding: 12px 16px;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .form-control-modern::placeholder {
            color: #9ca3af;
        }

        .form-control-modern:focus {
            background: #ffffff;
            border-color: #3b82f6;
            outline: none;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        .form-control-modern.is-invalid {
            border-color: #dc2626;
            box-shadow: 0 0 0 3px rgba(220, 38, 38, 0.1);
        }

    /* Validation Feedback */
    .invalid-feedback {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 6px;
    }

    /* Availability Alert */
    .alert-modern-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        padding: 16px 20px;
        color: #16a34a;
    }

    .alert-modern-danger {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 16px 20px;
        color: #dc2626;
    }

    /* Validation Summary */
    .validation-summary-modern {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 8px;
        padding: 16px 20px;
        color: #dc2626;
        margin-bottom: 20px;
    }

    /* Buttons */
    .btn-primary-modern {
        background: #3b82f6;
        border: none;
        color: #ffffff;
        font-weight: 500;
        padding: 12px 28px;
        border-radius: 6px;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .btn-primary-modern:hover:not(:disabled) {
            background: #2563eb;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
            color: #ffffff;
        }

        .btn-primary-modern:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .btn-secondary-modern {
        background: #ffffff;
        border: 1px solid #d1d5db;
        color: #6b7280;
        font-weight: 500;
        padding: 12px 28px;
        border-radius: 6px;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .btn-secondary-modern:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #374151;
        }

    /* Icon Styling */
    .icon-primary {
        color: #3b82f6;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .edit-card-body {
            padding: 20px;
        }

        .room-info-box {
            padding: 16px;
        }
    }
</style>

<div class="edit-booking-page-container">
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="edit-card">
                    <div class="edit-card-header">
                        <div class="d-flex align-items-center justify-content-between">
                            <h4>
                                <i class="fas fa-edit icon-primary"></i> Edit Booking
                            </h4>
                            <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.Id"
                               class="btn btn-secondary-modern btn-sm">
                                <i class="fas fa-arrow-left"></i> Back to Details
                            </a>
                        </div>
                    </div>
                    <div class="edit-card-body">
                        @if (ViewBag.Room != null)
                        {
                            <!-- Room Information -->
                            <div class="room-info-box">
                                <h5>
                                    <i class="fas fa-door-open icon-primary"></i> @ViewBag.Room.Name
                                </h5>
                                <p>
                                    <i class="fas fa-building icon-primary"></i> <strong>Campus:</strong> @ViewBag.Room.CampusName<br>
                                    <i class="fas fa-tag icon-primary"></i> <strong>Type:</strong> @ViewBag.Room.TypeDisplay<br>
                                    <i class="fas fa-users icon-primary"></i> <strong>Capacity:</strong> @ViewBag.Room.Capacity people
                                </p>
                            </div>

                            <!-- Edit Form -->
                            <form asp-controller="Booking" asp-action="Edit" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="Id" />

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="StartTime" class="form-label-modern">
                                            <i class="fas fa-calendar-alt"></i> Start Time
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input type="datetime-local"
                                               class="form-control form-control-modern @(ViewData.ModelState["StartTime"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                               asp-for="StartTime" id="startTime" required>
                                        <span asp-validation-for="StartTime" class="invalid-feedback"></span>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label asp-for="EndTime" class="form-label-modern">
                                            <i class="fas fa-calendar-alt"></i> End Time
                                            <span class="text-danger">*</span>
                                        </label>
                                        <input type="datetime-local"
                                               class="form-control form-control-modern @(ViewData.ModelState["EndTime"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                               asp-for="EndTime" id="endTime" required>
                                        <span asp-validation-for="EndTime" class="invalid-feedback"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div id="availabilityCheck" class="alert" style="display:none;"></div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="Purpose" class="form-label-modern">
                                        <i class="fas fa-edit"></i> Purpose
                                        <span class="text-danger">*</span>
                                    </label>
                                    <textarea class="form-control form-control-modern @(ViewData.ModelState["Purpose"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                              asp-for="Purpose" rows="5" required></textarea>
                                    <span asp-validation-for="Purpose" class="invalid-feedback"></span>
                                </div>

                                <div asp-validation-summary="ModelOnly" class="validation-summary-modern" role="alert"></div>

                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.Id"
                                       class="btn btn-secondary-modern">
                                        <i class="fas fa-times"></i> Cancel
                                    </a>
                                    <button type="submit" class="btn btn-primary-modern" id="submitBtn">
                                        <i class="fas fa-save"></i> Update Booking
                                    </button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            let availabilityTimeout;
            const bookingId = '@Model.Id';
            const roomId = '@ViewBag.Room?.Id';

            function checkAvailability() {
                const startTime = $('#startTime').val();
                const endTime = $('#endTime').val();

                if (startTime && endTime) {
                    $.ajax({
                        url: '@Url.Action("CheckAvailability", "Booking")',
                        type: 'POST',
                        data: {
                            roomId: roomId,
                            startTime: startTime,
                            endTime: endTime,
                            bookingId: bookingId
                        },
                        success: function (data) {
                            const alertDiv = $('#availabilityCheck');
                            const submitBtn = $('#submitBtn');

                            if (data.available) {
                                alertDiv.removeClass('alert-danger alert-modern-danger').addClass('alert-modern-success');
                                alertDiv.html('<i class="fas fa-check-circle"></i> Room is available for the selected time!');
                                alertDiv.show();
                                submitBtn.prop('disabled', false);
                            } else {
                                alertDiv.removeClass('alert-success alert-modern-success').addClass('alert-modern-danger');
                                alertDiv.html('<i class="fas fa-times-circle"></i> Room is not available for the selected time. Please choose a different time.');
                                alertDiv.show();
                                submitBtn.prop('disabled', true);
                            }
                        }
                    });
                }
            }

            $('#startTime, #endTime').on('change', function () {
                clearTimeout(availabilityTimeout);
                availabilityTimeout = setTimeout(checkAvailability, 500);
            });

            // Initial check
            checkAvailability();
        });
    </script>
}