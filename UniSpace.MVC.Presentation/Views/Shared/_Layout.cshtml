<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniSpace</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Default site css -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Razor generated styles -->
    <link rel="stylesheet" href="~/UniSpace.MVC.Presentation.styles.css" asp-append-version="true" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- Cyber Theme CSS -->
    <link rel="stylesheet" href="~/css/campus-cyber.css" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-graduation-cap"></i> UniSpace
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- LEFT MENU -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Schedule" asp-action="Index">
                                <i class="fas fa-calendar-alt"></i> Schedule
                            </a>
                        </li>

                        @if (Context.Session.GetString("AuthToken") != null)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Index">
                                        <i class="fas fa-tachometer-alt"></i> Dashboard
                                    </a>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" data-bs-toggle="dropdown">
                                    <i class="fas fa-calendar"></i> Bookings
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Booking" asp-action="SearchRooms">
                                            <i class="fas fa-search"></i> Search Rooms
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Booking" asp-action="MyBookings">
                                            <i class="fas fa-list"></i> My Bookings
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Booking" asp-action="PendingApprovals">
                                                <i class="fas fa-clock"></i> Pending Approvals
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Booking" asp-action="Index">
                                                <i class="fas fa-calendar-check"></i> All Bookings
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" data-bs-toggle="dropdown">
                                    <i class="fas fa-building"></i> Facilities
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Campus" asp-action="Index">
                                            <i class="fas fa-university"></i> Campuses
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Room" asp-action="Index">
                                            <i class="fas fa-door-open"></i> All Rooms
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Campus" asp-action="Create">
                                            <i class="fas fa-plus"></i> Add Campus
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Room" asp-action="Create">
                                            <i class="fas fa-plus"></i> Add Room
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Schedule" asp-action="Create">
                                            <i class="fas fa-plus"></i> Add Schedule
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Campus" asp-action="Index">
                                    <i class="fas fa-university"></i> Campuses
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Room" asp-action="Index">
                                    <i class="fas fa-door-open"></i> Rooms
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- RIGHT MENU -->
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("AuthToken") != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle"></i> Account
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-user"></i> Profile</a></li>
                                    <li><a class="dropdown-item" href="#"><i class="fas fa-cog"></i> Settings</a></li>
                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">
                                                <i class="fas fa-sign-out-alt"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Register">
                                    <i class="fas fa-user-plus"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- ALERTS -->
    <div id="alert-container" class="position-fixed top-0 end-0 m-3" style="z-index:1050;">
        @* Error Alert *@
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @* Success Alert *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            &copy; 2025 - UniSpace - Room Booking Management System
        </div>
    </footer>

    <!-- JS Libraries -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- ALERT SCRIPT -->
    <script>
        $(document).ready(function () {
            $('#alert-container .alert').each(function () {
                const $alert = $(this);
                if ($alert.text().trim() !== '') {
                    $alert.fadeIn();
                    setTimeout(() => $alert.fadeOut(500, function () {
                        $(this).remove();
                    }), 3000); // 3 seconds
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>