@model UniSpace.Bo.DTOs.RoomDTOs.UpdateRoomDto
@using UniSpace.Bo.DTOs.CampusDTOs
@{
    ViewData["Title"] = "Edit Room";
    var campuses = ViewBag.Campuses as IEnumerable<CampusDto>;
}

<style>
    /* Page Container */
    .edit-room-container {
        min-height: 100vh;
        background: #ffffff;
        padding: 40px 0;
    }

    /* Header */
    .page-header {
        background: linear-gradient(135deg, #f0f9ff 0%, #ffffff 100%);
        border-radius: 12px;
        padding: 30px;
        margin-bottom: 30px;
        border: 1px solid #e5e7eb;
    }

        .page-header h1 {
            color: #1f2937;
            font-weight: 700;
            font-size: 2rem;
            margin: 0;
        }

        .page-header p {
            color: #6b7280;
            font-size: 1rem;
            margin: 8px 0 0 0;
        }

    /* Form Wrapper */
    .form-wrapper {
        max-width: 900px;
        margin: 0 auto;
    }

    /* Glass Box */
    .glass-box {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 32px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }

        .glass-box h2 {
            color: #1f2937;
            font-weight: 600;
            font-size: 1.5rem;
            margin-bottom: 8px;
        }

    .muted {
        color: #6b7280;
        font-size: 0.9375rem;
        margin-bottom: 24px;
    }

    /* Form Elements */
    .cyber-form .mb-3 {
        margin-bottom: 24px;
    }

    .form-label {
        color: #374151;
        font-weight: 500;
        font-size: 0.875rem;
        margin-bottom: 8px;
        display: block;
    }

        .form-label i {
            color: #3b82f6;
            margin-right: 6px;
        }

    .form-control {
        background: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        padding: 12px 16px;
        width: 100%;
        font-size: 0.9375rem;
        color: #1f2937;
        transition: all 0.2s ease;
    }

        .form-control::placeholder {
            color: #9ca3af;
        }

        .form-control:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

    .text-danger {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 6px;
        display: block;
    }

    /* Form Actions */
    .form-actions {
        display: flex;
        gap: 12px;
        margin-top: 32px;
    }

    .btn-strong {
        background: #3b82f6;
        border: none;
        color: #ffffff;
        padding: 12px 28px;
        border-radius: 8px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .btn-strong:hover {
            background: #2563eb;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
        }

    .btn-soft {
        background: #ffffff;
        border: 1px solid #d1d5db;
        color: #6b7280;
        padding: 12px 28px;
        border-radius: 8px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s ease;
        font-size: 0.9375rem;
    }

        .btn-soft:hover {
            background: #f9fafb;
            border-color: #9ca3af;
            color: #374151;
        }

    /* Icon Styling */
    .icon-primary {
        color: #3b82f6;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .glass-box {
            padding: 24px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-strong,
        .btn-soft {
            width: 100%;
        }
    }
</style>

<div class="edit-room-container">
    <div class="container-fluid">
        <div class="page-header">
            <h1><i class="fas fa-edit icon-primary"></i> Edit Room</h1>
            <p>Update room information</p>
        </div>

        <div class="form-wrapper">
            <div class="glass-box">
                <h2>Update Room</h2>
                <p class="muted">Edit room information</p>

                <form asp-action="Edit" method="post" class="cyber-form">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="CampusId" class="form-label">
                            <i class="fas fa-university"></i> Select Campus <span class="text-danger">*</span>
                        </label>
                        <select asp-for="CampusId" class="form-control" required>
                            <option value="">-- Select Campus --</option>
                            @if (campuses != null)
                            {
                                foreach (var c in campuses)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="CampusId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-door-open"></i> Room Name <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Room 101, Hall A..." required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Type" class="form-label">
                                <i class="fas fa-tag"></i> Room Type <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Type" class="form-control"
                                    asp-items="Html.GetEnumSelectList<UniSpace.Bo.Enums.RoomType>()" required>
                            </select>
                            <span asp-validation-for="Type" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Capacity" class="form-label">
                                <i class="fas fa-users"></i> Capacity <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Capacity" type="number" class="form-control" min="1" required />
                            <span asp-validation-for="Capacity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CurrentStatus" class="form-label">
                                <i class="fas fa-calendar-check"></i> Booking Status <span class="text-danger">*</span>
                            </label>
                            <select asp-for="CurrentStatus" class="form-control"
                                    asp-items="Html.GetEnumSelectList<UniSpace.Bo.Enums.BookingStatus>()" required>
                            </select>
                            <span asp-validation-for="CurrentStatus" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="RoomStatus" class="form-label">
                                <i class="fas fa-info-circle"></i> Room Status <span class="text-danger">*</span>
                            </label>
                            <select asp-for="RoomStatus" class="form-control"
                                    asp-items="Html.GetEnumSelectList<UniSpace.Bo.Enums.RoomStatus>()" required>
                            </select>
                            <span asp-validation-for="RoomStatus" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">
                            <i class="fas fa-align-left"></i> Description
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Detailed description of the room..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-strong">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn-soft">
                            <i class="fas fa-times"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}