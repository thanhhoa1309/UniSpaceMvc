@model UniSpace.Bo.DTOs.RoomDTOs.RoomDto

@{
    ViewData["Title"] = "Chi tiết phòng - " + Model.Name;
}

<div class="container py-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb cyber-breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Room" asp-action="Index">Rooms</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Detail Header -->
    <div class="row align-items-center mb-5">
        <div class="col-md-8">
            <div class="d-flex align-items-center gap-3">
                <h1 class="display-4 fw-bold text-cyber-gradient mb-0">@Model.Name</h1>
                <span class="badge bg-cyber-primary fs-5">@Model.Type</span>
            </div>
            <p class="lead text-muted mt-2">
                <i class="fas fa-map-marker-alt me-2"></i> @Model.CampusName
            </p>
        </div>
        <div class="col-md-4 text-md-end">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-cyber-warning me-2">
                    <i class="fas fa-edit me-1"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-cyber-danger">
                    <i class="fas fa-trash me-1"></i> Delete
                </a>
            }
        </div>
    </div>

    <!-- Detail Content -->
    <div class="row g-4">
        <!-- Left Column: Info -->
        <div class="col-lg-8">
            <div class="card cyber-card h-100">
                <div class="card-header bg-transparent border-bottom border-secondary">
                    <h4 class="card-title text-cyber-info mb-0">Thông tin chi tiết</h4>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="info-item">
                                <label class="text-muted small">Sức chứa</label>
                                <div class="fs-4 fw-bold">@Model.Capacity <span
                                        class="fs-6 fw-normal text-muted">người</span></div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="info-item">
                                <label class="text-muted small">Trạng thái phòng</label>
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    @if (Model.RoomStatus == UniSpace.Bo.Enums.RoomStatus.Active)
                                    {
                                        <i class="fas fa-check-circle text-success fs-4"></i>
                                        <span class="fs-5 text-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-times-circle text-danger fs-4"></i>
                                        <span class="fs-5 text-danger">Bảo trì/Đóng</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="info-item">
                                <label class="text-muted small">Trạng thái đặt</label>
                                <div class="fs-5">@Model.CurrentStatus</div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="info-item">
                                <label class="text-muted small">Báo cáo chờ xử lý</label>
                                <div class="fs-5 ms-3">
                                    @if (Model.PendingReports > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill">@Model.PendingReports vấn đề</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill">Không có</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="info-item mt-3">
                                <label class="text-muted small mb-2">Mô tả</label>
                                <p class="p-3 bg-dark bg-opacity-50 rounded border border-secondary text-light">
                                    @(string.IsNullOrEmpty(Model.Description) ? "Chưa có mô tả cho phòng này." :
                                        Model.Description)
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Stats / Actions -->
        <div class="col-lg-4">
            <div class="card cyber-card mb-4">
                <div class="card-header bg-transparent border-bottom border-secondary">
                    <h5 class="card-title text-cyber-info mb-0">Thống kê nhanh</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush bg-transparent">
                        <li
                            class="list-group-item bg-transparent text-light d-flex justify-content-between align-items-center px-0">
                            <span><i class="fas fa-calendar-check me-2 text-primary"></i> Tổng lượt đặt</span>
                            <span class="badge bg-primary rounded-pill">@Model.TotalBookings</span>
                        </li>
                        <li
                            class="list-group-item bg-transparent text-light d-flex justify-content-between align-items-center px-0">
                            <span><i class="fas fa-clock me-2 text-info"></i> Ngày tạo</span>
                            <span class="small font-monospace">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Booking Action -->
            <div class="card cyber-card border-cyber-primary">
                <div class="card-body text-center">
                    <h5 class="card-title mb-3">Bạn muốn đặt phòng này?</h5>
                    <p class="small text-muted mb-4">Kiểm tra lịch trống và đặt phòng ngay cho sự kiện của bạn.</p>
                    <a asp-controller="Booking" asp-action="Create" asp-route-roomId="@Model.Id"
                        class="btn btn-lg btn-cyber-primary w-100 neon-shadow">
                        <i class="fas fa-calendar-plus me-2"></i> Đặt phòng ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Inline styles for Detail Page - should move to css file in production */
    .cyber-card {
        background: rgba(30, 30, 40, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        border-radius: 15px;
        transition: transform 0.3s ease;
    }

    .cyber-card:hover {
        transform: translateY(-5px);
        border-color: rgba(64, 224, 208, 0.3);
    }

    .text-cyber-gradient {
        background: linear-gradient(45deg, #00f260, #0575e6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .btn-cyber-primary {
        background: linear-gradient(45deg, #4facfe 0%, #00f2fe 100%);
        border: none;
        color: white;
        font-weight: 600;
        transition: all 0.3s;
    }

    .btn-cyber-primary:hover {
        transform: scale(1.05);
        box-shadow: 0 0 15px rgba(0, 242, 254, 0.5);
    }

    .neon-shadow {
        box-shadow: 0 0 10px rgba(79, 172, 254, 0.5);
    }

    .info-item label {
        display: block;
        margin-bottom: 0.25rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 0.75rem;
    }
</style>
